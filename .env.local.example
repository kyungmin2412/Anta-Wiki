# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
#
# 아무것도 설정하지 않아도 위키는 정상 동작합니다 — 다만 리포트 업로드 버튼(/upload)과
# `npm run ingest` 는 아래 둘 중 하나가 있어야 리포트 PDF를 읽을 수 있습니다.
# (구독만으로 추가 결제 없이 넣는 방법은 README의 "리포트를 넣는 두 가지 경로" 참고 —
#  '리포트 넣기.bat/.command' 또는 '리포트 넣기 (Codex).bat/.command')

# ── Claude 사용 시 ──────────────────────────────────────────
# console.anthropic.com 에서 발급. Claude 구독과는 별도로 크레딧 충전이 필요합니다.
# ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI(GPT) 사용 시 ─────────────────────────────────────
# platform.openai.com 에서 발급. ChatGPT 구독과는 별도로 크레딧 충전이 필요합니다.
# OPENAI_API_KEY=sk-proj-...

# 둘 다 설정했다면 어느 쪽을 쓸지 명시하세요 (기본값은 anthropic):
# AI_PROVIDER=openai

# 모델을 바꾸고 싶을 때만 (기본값을 권장합니다 — 논조 판단에는 강한 추론이 필요합니다):
# ANTA_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.4-mini
